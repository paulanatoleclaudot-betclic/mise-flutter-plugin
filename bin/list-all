#!/usr/bin/env bash
#
# List installable Flutter versions. Mirrors the stock behaviour: official
# stable releases, bare version (no channel suffix). Beta/dev and arbitrary
# commits are reachable explicitly via `flutter@ref:<branch|tag|sha>`.

set -euo pipefail
PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/utils.bash
source "${PLUGIN_DIR}/lib/utils.bash"

print_stable_versions
echo
